# ==============================================================================
# 🏛️ VELOURA LIVING — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env` or `.env.local`
#    PowerShell: cp .env.example .env.local
# 2. Fill in your local values for development or production cloud credentials.
# 3. DO NOT commit your actual `.env` file containing secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 1. APPLICATION & PORTS
# ------------------------------------------------------------------------------
NODE_ENV="development" # Options: "development" | "production" | "test"
PORT=5000              # Standalone Node.js Backend REST API Port

# Frontend URLs
NEXT_PUBLIC_APP_NAME="Veloura Living"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Standalone Backend URL (if calling port 5000 directly from mobile or external apps)
BACKEND_API_URL="http://localhost:5000"


# ------------------------------------------------------------------------------
# 🗄️ 2. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# [OPTION A: LOCAL POSTGRESQL (Development)]
# Format: postgresql://<username>:<password>@localhost:5432/<database_name>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veloura_living"

# [OPTION B: CLOUD POSTGRESQL (Production - Supabase / Neon / Render / AWS RDS)]
# Example Supabase Pooled URL (Port 6543 for serverless / transaction mode):
# DATABASE_URL="postgresql://postgres.your-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase API Keys (Optional - only required if using Supabase Auth or Cloud Storage directly)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"


# ------------------------------------------------------------------------------
# 🔐 3. AUTHENTICATION & SECURITY (JWT, Sessions, Cookies)
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 64-character random string for production:
# Node command: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET="veloura-living-master-luxury-jwt-secret-2026-auth-token-change-in-prod"
JWT_EXPIRES_IN="15m"         # Access token lifetime
JWT_REFRESH_EXPIRES_IN="7d"  # Refresh token lifetime


# ------------------------------------------------------------------------------
# 📜 4. BUSINESS & GST INVOICING COMPLIANCE (India / Maharashtra)
# ------------------------------------------------------------------------------
BUSINESS_LEGAL_NAME="Veloura Living Private Limited"
BUSINESS_TRADE_NAME="Veloura Living"
BUSINESS_GSTIN="27AABCV1234F1Z5"
BUSINESS_PAN="AABCV1234F"
BUSINESS_STATE="Maharashtra"
BUSINESS_STATE_CODE="27"
BUSINESS_ADDRESS="Plot 42, Luxury Design District, Worli, Mumbai, Maharashtra 400018"
BUSINESS_SUPPORT_EMAIL="concierge@velouraliving.com"
BUSINESS_SUPPORT_PHONE="+91 22 8900 1200"


# ------------------------------------------------------------------------------
# 💳 5. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER="razorpay" # Options: "razorpay" | "stripe" (v2)

# Razorpay Test / Live Keys
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_veloura_living_demo"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"


# ------------------------------------------------------------------------------
# 📧 6. TRANSACTIONAL NOTIFICATIONS (SMTP / Resend / Gmail)
# ------------------------------------------------------------------------------
# For local testing, leave empty to log notification emails to console.
# For production email delivery via SMTP (e.g. Gmail App Password, Resend, SendGrid, Amazon SES):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM="Veloura Concierge <concierge@velouraliving.com>"


# ------------------------------------------------------------------------------
# 🤖 7. GOOGLE GEMINI AI SUITE (Spatial Consultant & Intelligence)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your-google-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"


# ------------------------------------------------------------------------------
# 🚚 8. LOGISTICS, SHIPPING & TAX DEFAULTS
# ------------------------------------------------------------------------------
SHIPPING_CARRIER="Veloura White-Glove Logistics"
DEFAULT_TAX_RATE="0.18"        # 18% GST (9% CGST + 9% SGST / 18% IGST)
DOMESTIC_SHIPPING_FLAT=199    # Flat ₹199 under ₹2,999
FREE_SHIPPING_THRESHOLD=2999  # Free standard shipping at/above ₹2,999
INTERNATIONAL_SHIPPING_FLAT=5000 # Flat ₹5,000 for exports
