# ==============================================================================
# 🏛️ VELOURA LIVING — FRONTEND & FULL-STACK ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env.local` for local Next.js development:
#    PowerShell: cp .env.example .env.local
# 2. For Vercel Production Deployment:
#    Add these keys in Vercel Dashboard -> Settings -> Environment Variables.
# 3. SECURITY: Never commit real `.env` or `.env.local` files containing secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV="development" # Options: "development" | "production" | "test"
PORT=3000

# Canonical Storefront URLs
NEXT_PUBLIC_APP_NAME="Veloura Living"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Render Standalone Backend REST API URL (When deployed to Render)
# Set to your Render web service URL, e.g. "https://veloura-living-backend.onrender.com"
NEXT_PUBLIC_BACKEND_URL="http://localhost:5000"
BACKEND_API_URL="http://localhost:5000"


# ------------------------------------------------------------------------------
# 🗄️ 2. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# [OPTION A: LOCAL POSTGRESQL (Development)]
# Format: postgresql://<username>:<password>@localhost:5432/<database_name>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veloura_living"

# [OPTION B: CLOUD POSTGRESQL (Production - Supabase / Neon / Render / AWS RDS)]
# Example Supabase Pooled URL (Port 6543 for serverless / transaction mode):
# DATABASE_URL="postgresql://postgres.your-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase API Keys (Optional - only required if using Supabase client directly)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"


# ------------------------------------------------------------------------------
# 🔐 3. AUTHENTICATION & SECURITY (JWT, Sessions & Passwords)
# ------------------------------------------------------------------------------
# Cryptographically secure random string for JWT signing:
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="veloura-living-master-luxury-jwt-secret-2026-auth-token-change-in-prod"
JWT_EXPIRES_IN="15m"         # Access token lifetime
JWT_REFRESH_EXPIRES_IN="7d"  # Refresh token lifetime
ADMIN_INITIAL_PASSWORD="VelouraAdmin2026!"

# Google OAuth 2.0 (Optional — for Google Sign-In)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"


# ------------------------------------------------------------------------------
# 💳 4. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER="razorpay"

# Razorpay Client-Side Key (Publicly accessible in browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_veloura_living_demo"

# Razorpay Server-Side Private Secrets (Keep private on server)
RAZORPAY_KEY_ID="rzp_test_veloura_living_demo"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"


# ------------------------------------------------------------------------------
# 📧 5. TRANSACTIONAL NOTIFICATIONS (Brevo Email & SMS)
# ------------------------------------------------------------------------------
# [OPTION A: BREVO (formerly Sendinblue) - RECOMMENDED FOR OTP & NOTIFICATIONS]
# Get your API key: Brevo Dashboard -> SMTP & API -> API Keys
BREVO_API_KEY="xkeysib-your-brevo-v3-api-key"
BREVO_SENDER_EMAIL="concierge@velouraliving.com"
BREVO_SENDER_NAME="Veloura Concierge"

# [OPTION B: BREVO / SMTP RELAY]
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-brevo-login-email@example.com"
SMTP_PASS="xsmtpsib-your-brevo-master-smtp-key"
SMTP_FROM="Veloura Concierge <concierge@velouraliving.com>"

# [SMS GATEWAYS (Optional - Fast2SMS / Twilio for mobile OTP & alerts)]
FAST2SMS_API_KEY="your-fast2sms-api-key"
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"


# ------------------------------------------------------------------------------
# 🤖 6. GOOGLE GEMINI AI SUITE (Spatial Consultant & Interior Intelligence)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your-google-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"


# ------------------------------------------------------------------------------
# 📜 7. BUSINESS & GST INVOICING COMPLIANCE (India / Maharashtra)
# ------------------------------------------------------------------------------
BUSINESS_LEGAL_NAME="Veloura Living Private Limited"
BUSINESS_TRADE_NAME="Veloura Living"
BUSINESS_GSTIN="27AABCV1234F1Z5"
BUSINESS_PAN="AABCV1234F"
BUSINESS_STATE="Maharashtra"
BUSINESS_STATE_CODE="27"
BUSINESS_ADDRESS="Plot 42, Luxury Design District, Worli, Mumbai, Maharashtra 400018"
BUSINESS_SUPPORT_EMAIL="concierge@velouraliving.com"
BUSINESS_SUPPORT_PHONE="+91 22 8900 1200"


# ------------------------------------------------------------------------------
# 🚚 8. LOGISTICS, SHIPPING & TAX DEFAULTS
# ------------------------------------------------------------------------------
DEFAULT_CURRENCY="INR"
SHIPPING_CARRIER="Veloura White-Glove Logistics"
DEFAULT_TAX_RATE="0.18"        # 18% GST (9% CGST + 9% SGST / 18% IGST)
DOMESTIC_SHIPPING_FLAT=199    # Flat ₹199 under ₹2,999
FREE_SHIPPING_THRESHOLD=2999  # Free standard shipping at/above ₹2,999
INTERNATIONAL_SHIPPING_FLAT=5000 # Flat ₹5,000 for exports
