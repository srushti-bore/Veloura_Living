# ==============================================================================
# 🏛️ Veloura Living — Environment Configuration Template
# Reference: docs/Veloura_Living_SRS.md (Section 31, 44, 65)
# ==============================================================================

# Application & Frontend
NEXT_PUBLIC_APP_NAME="Veloura Living"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NODE_ENV="development"

# Supabase PostgreSQL & Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres"

# Authentication & Security (JWT & Cookies)
JWT_SECRET="generate-a-secure-random-64-char-secret-key-here"
JWT_EXPIRES_IN="7d"

# Google Gemini AI Suite (2026 Era Intelligence Layer)
GEMINI_API_KEY="your-google-gemini-ai-api-key"

# Payment Gateway (Razorpay / Stripe)
PAYMENT_GATEWAY_PROVIDER="razorpay"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Logistics & White-Glove Shipping
SHIPPING_CARRIER="Veloura White-Glove Logistics"
DEFAULT_TAX_RATE="0.18"
