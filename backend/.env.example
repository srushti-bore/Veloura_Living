# ==============================================================================
# 🏛️ VELOURA LIVING — BACKEND REST API ENVIRONMENT BLUEPRINT (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `backend/.env`
#    PowerShell (inside backend folder): cp .env.example .env
# 2. Fill in your local PostgreSQL or cloud credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 1. BACKEND SERVER & APP PORTS
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV="development" # Options: "development" | "production" | "test"

# Frontend Web Application URL (used for password reset / verification links)
APP_URL="http://localhost:3000"
API_BASE_URL="http://localhost:5000/api"


# ------------------------------------------------------------------------------
# 🗄️ 2. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# [OPTION A: LOCAL POSTGRESQL (Development)]
# Format: postgresql://<username>:<password>@localhost:5432/<database_name>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veloura_living"

# [OPTION B: CLOUD POSTGRESQL (Production - Supabase / Neon / Render / AWS RDS)]
# Example Supabase Pooled URL:
# DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Storage & Role Keys (Optional)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"


# ------------------------------------------------------------------------------
# 🔐 3. AUTHENTICATION & SECURITY (JWT & Password Hashing)
# ------------------------------------------------------------------------------
JWT_SECRET="veloura-living-master-luxury-jwt-secret-2026-auth-token-change-in-prod"
JWT_EXPIRES_IN="15m"         # Access token lifetime
JWT_REFRESH_EXPIRES_IN="7d"  # Refresh token lifetime
PASSWORD_SALT_ROUNDS=12


# ------------------------------------------------------------------------------
# 📜 4. GST INVOICING & BUSINESS COMPLIANCE (India)
# ------------------------------------------------------------------------------
BUSINESS_LEGAL_NAME="Veloura Living Private Limited"
BUSINESS_GSTIN="27AABCV1234F1Z5"
BUSINESS_PAN="AABCV1234F"
BUSINESS_STATE="Maharashtra"
BUSINESS_STATE_CODE="27"
BUSINESS_SUPPORT_EMAIL="concierge@velouraliving.com"


# ------------------------------------------------------------------------------
# 💳 5. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER="razorpay"
RAZORPAY_KEY_ID="rzp_test_veloura_living_demo"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"


# ------------------------------------------------------------------------------
# 📧 6. TRANSACTIONAL NOTIFICATIONS (Brevo / Sendinblue / SMTP / Resend)
# ------------------------------------------------------------------------------
# [OPTION A: BREVO (formerly Sendinblue) - RECOMMENDED FOR TRANSACTIONAL EMAILS]
# Get your SMTP keys: Brevo Dashboard -> Transactional -> Settings -> Configuration
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-brevo-login-email@example.com"
SMTP_PASS="xsmtpsib-your-brevo-master-smtp-key"
SMTP_FROM="Veloura Concierge <your-verified-brevo-sender@yourdomain.com>"

# [OPTION B: BREVO REST API (Optional - For Direct API / WhatsApp / SMS Gateway)]
# Get your API key: Brevo Dashboard -> SMTP & API -> API Keys
BREVO_API_KEY="xkeysib-your-brevo-v3-api-key"
BREVO_SENDER_EMAIL="your-verified-brevo-sender@yourdomain.com"
BREVO_SENDER_NAME="Veloura Concierge"

# [OPTION C: GMAIL / RESEND SMTP FALLBACK]
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-character-app-password"
# SMTP_FROM="Veloura Concierge <concierge@velouraliving.com>"


# ------------------------------------------------------------------------------
# 🤖 7. GOOGLE GEMINI AI
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"


# ------------------------------------------------------------------------------
# 🚚 8. LOGISTICS & SHIPPING RULES (SRS v1.1)
# ------------------------------------------------------------------------------
DEFAULT_CURRENCY="INR"
DEFAULT_TAX_RATE="0.18"        # 18% GST
DOMESTIC_SHIPPING_FLAT=199    # Flat ₹199 under ₹2,999
FREE_SHIPPING_THRESHOLD=2999  # Free standard shipping at/above ₹2,999
INTERNATIONAL_SHIPPING_FLAT=5000 # Flat ₹5,000 for exports
